# Settings for the emergency page's Cloud Functions. See Doc/EMERGENCY_PAGE.md.
#
# Deploy: copy this to .env (gitignored) in this folder and fill it in.
# Emulators: put the same names in .env.local (gitignored); it wins over .env there.
# If a value is missing at deploy time, the Firebase CLI asks for it and saves it to
# .env.<project-id>, which is gitignored too.

# Google accounts that may use the admin panel, comma-separated. Capital letters don't matter.
# Each must be a verified Google address. Someone taken off the list loses admin the next time
# their page calls a function; to cut them off at once, also delete that account in the Firebase
# console (Authentication → Users).
ADMIN_EMAILS=you@example.com

# Member emails (welcome, password reset, new card) go out through Gmail SMTP from this Gmail
# address, signed in with a Google App Password. Leave it empty and nothing is sent: the admin
# panel says "email not configured" and shows everything on screen instead.
GMAIL_USER=you@gmail.com

# The sender name members see.
MAIL_FROM_NAME="Emergency page"

# The App Password itself is a secret, so it never goes in a .env file. Turn on 2-Step
# Verification for GMAIL_USER, create an App Password at https://myaccount.google.com/apppasswords
# and store it in Secret Manager (paste it when asked, with or without its spaces):
#
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
#
# Deploy after setting it: functions read a secret's latest version only when they start. For the
# emulators, firebase/functions/.secret.local (gitignored) holds a placeholder instead:
#
#   GMAIL_APP_PASSWORD=emulator-placeholder
