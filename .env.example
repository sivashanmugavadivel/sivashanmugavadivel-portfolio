# Settings for the emergency page (/emergency). See Doc/EMERGENCY_PAGE.md.
#
# Local: copy this to .env.local (gitignored) and fill it in.
# Live site: add the same names as GitHub repository variables (Settings → Secrets and
# variables → Actions → Variables); deploy.yml passes them to the build. They all end up in
# the page's JavaScript, so none of them is a secret.
#
# With the Firebase values empty, `pnpm dev` runs demo mode (sign in as demo / demo1234; the
# card /emergency?id=testcard23 opens with PIN 123456), and a production build shows
# "This emergency page isn't set up yet" with only the call buttons.

# Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match REGION in firebase/functions/index.js
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Dev server only: 1 = use the local Firebase emulators (auth 9099, firestore 8080, functions 5001).
# Builds ignore it. See "Against the Firebase emulators" in Doc/EMERGENCY_PAGE.md.
VITE_FIREBASE_EMULATORS=

# How many digits visitors are told to expect (4–8). Six or more recommended.
VITE_EMERGENCY_PIN_LENGTH=6

# The link the QR code and NFC tag open. Defaults to https://sivashanmugavadivel.in/emergency
# in production builds; leave it empty unless the address changes.
VITE_EMERGENCY_PAGE_URL=

# Google Maps for "Nearby help": a browser key with Maps JavaScript API and Places API (New)
# enabled, restricted to your domain. Without it the section shows only "Search in Google Maps" links.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID from Google Maps Platform → Map management (JavaScript, Vector). Empty = DEMO_MAP_ID, for testing only.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: reCAPTCHA Enterprise site key for App Check. Leave empty until you register the web
# app; then see ENFORCE_APP_CHECK in firebase/functions/index.js.
VITE_RECAPTCHA_SITE_KEY=
